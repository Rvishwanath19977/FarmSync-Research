# FarmSync-Research local environment configuration
#
# IMPORTANT:
# Core scientific reproduction does NOT require an OpenAI API key.
# LLM functionality is optional and is not authoritative for
# allocation, feasibility, crop selection, consent, fairness,
# optimization, reoptimization, or execution.

# Safe default: deterministic research/UI operation without live LLM calls.
FARMSYNC_LLM_MODE=off

# Optional live LLM configuration.
# Set FARMSYNC_LLM_MODE=live and provide your own API key locally.
OPENAI_API_KEY=

# Default model used by the current FarmSync live-LLM integration.
FARMSYNC_LLM_MODEL=gpt-5.6-terra

# Optional OpenAI-compatible endpoint.
# Leave empty when using the official OpenAI endpoint.
FARMSYNC_LLM_BASE_URL=

# Live LLM runtime options.
FARMSYNC_LLM_TIMEOUT=30
FARMSYNC_LLM_MAX_RETRIES=2
FARMSYNC_LLM_REASONING_EFFORT=medium
FARMSYNC_LLM_MAX_OUTPUT_TOKENS=4096
